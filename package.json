{
  "name": "lab4",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт авторизации: React (Vite) + Node.js + PostgreSQL",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,green \"npm:server\" \"npm:client\"",
    "server": "node --env-file-if-exists=.env server.js",
    "client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "import-json": "node --env-file-if-exists=.env scripts/import-json.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
